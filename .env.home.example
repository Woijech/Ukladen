# Private deployment file: copy only if .env.home does not already exist.
# Use --env-file .env.home with docker-compose.yml + docker-compose.home.yml.
# Complete reference: docs/development/environment.md; setup: docs/deployment/home-server.md.
# Fill required blanks manually. This template is intentionally not deployment-ready.

# Application
# API, workers, Beat and migration share this file. No APP_ENV switch is implemented.

# Database
# Required. Reuse existing values with existing volumes; changing this file does not
# change an existing PostgreSQL password. Compose DSN components must be URL-safe.
POSTGRES_DB=ukladen
POSTGRES_USER=workspace
POSTGRES_PASSWORD=
# DATABASE_URL is supplied by Compose using postgres:5432. No host port is published.

# Redis
# REDIS_URL is supplied by Compose using redis:6379/0. No host port is published.

# Celery
# Uses REDIS_URL; keep one Beat instance. No separate broker/result ENV is implemented.

# Authentication
AUTH_SESSION_COOKIE_NAME=__Host-ukladen_session
AUTH_CSRF_COOKIE_NAME=__Host-ukladen_csrf
AUTH_OAUTH_COOKIE_NAME=__Host-ukladen_oauth
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_ALLOWED_ORIGINS='["https://ukladen.app"]'
# TTL, password and rate-limit overrides are optional; defaults are listed in environment.md.

# Google OAuth
# Optional. Obtain a Web application client from Google Cloud Console.
# Register this exact callback. Enable all five values together for browser login.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=https://ukladen.app/api/v1/auth/google/callback
# FRONTEND_AUTH_SUCCESS_URL=https://ukladen.app/workspace
# FRONTEND_AUTH_ERROR_URL=https://ukladen.app/auth/error
AUTH_OAUTH_STATE_TTL_SECONDS=600

# Email / SMTP
AUTH_EMAIL_DELIVERY_MODE=smtp
# Also supplies the origin for password-reset and Google confirmation links.
AUTH_EMAIL_VERIFICATION_URL=https://ukladen.app/auth/verify-email
# Required in smtp mode: host and verified bare sender address, obtained from your mail service.
# Supply username/password together when authentication is required; never paste a tunnel token.
# SMTP_HOST=smtp.example.com
# SMTP_FROM_EMAIL=your-verified-sender@example.com
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10
# For implicit TLS use SMTP_SECURITY=tls and SMTP_PORT=465. Do not use plaintext public SMTP.

# Storage
# Required. Retain existing storage credentials/bucket; do not replace them with sample values.
S3_ACCESS_KEY=
S3_SECRET_KEY=''
S3_BUCKET=materials
# S3_ENDPOINT is supplied by Compose using seaweedfs:8333; no storage port is published.

# University / Schedule
# Public IIS imports; no private university credentials.
SCHEDULE_SYNC_ENABLED=true
SCHEDULE_SYNC_INTERVAL_SECONDS=3600

# AI / LLM
# Runtime not implemented. Do not add real model/API keys to activate planned documentation.

# Logging / Monitoring
LOG_LEVEL=INFO

# Deployment / Security
# Required: token from Cloudflare's remotely managed tunnel Docker install command.
# Paste only the token, keep it out of chat/logs, and never commit this private file.
CLOUDFLARE_TUNNEL_TOKEN=
# Proxy trust is fixed in docker-compose.home.yml, not configured with a wildcard here.

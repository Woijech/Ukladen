# Private deployment file: copy to .env.home, never commit it.
# The home override reuses the existing ukladen data volumes.
# Keep the existing PostgreSQL credentials when reusing a database.
# Changing POSTGRES_PASSWORD here alone does not change an existing database password.
POSTGRES_DB=ukladen
POSTGRES_USER=workspace
POSTGRES_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=materials

AUTH_SESSION_COOKIE_NAME=__Host-ukladen_session
AUTH_CSRF_COOKIE_NAME=__Host-ukladen_csrf
AUTH_OAUTH_COOKIE_NAME=__Host-ukladen_oauth
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_ALLOWED_ORIGINS='["https://ukladen.app"]'
AUTH_EMAIL_VERIFICATION_URL=https://ukladen.app/auth/verify-email

AUTH_EMAIL_DELIVERY_MODE=smtp
# Copy your working SMTP settings from .env. Do not use Cloudflare's tunnel token here.
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM_EMAIL=your-verified-sender@example.com
SMTP_TIMEOUT_SECONDS=10

# Token of the remotely managed tunnel, from Cloudflare's Docker install command.
# Paste only the token, never the whole command. Keep it out of chat and logs.
CLOUDFLARE_TUNNEL_TOKEN=

# Google is optional; leave unset until the public callback is registered with Google.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=https://ukladen.app/api/v1/auth/google/callback
# FRONTEND_AUTH_SUCCESS_URL=https://ukladen.app/
# FRONTEND_AUTH_ERROR_URL=https://ukladen.app/

# Local development only. Copy only if .env does not already exist.
# Complete variable reference: docs/development/environment.md.
# Never commit real credentials. Optional settings should stay commented, not blank.

# Application
# Backend processes share this file. Settings read .env in their working directory;
# host commands use uv run --env-file ../../.env from apps/backend.
# Next.js has no public runtime configuration or browser-visible secrets.

# Database
# Required by Compose. Keep existing credentials when reusing a data volume.
# Compose assembles its DSN: use URL-safe username/password/database values.
POSTGRES_DB=ukladen
POSTGRES_USER=workspace
POSTGRES_PASSWORD=local-postgres-password
POSTGRES_HOST_PORT=5432
# Required for host backend/Alembic. Only the installed synchronous psycopg driver is supported.
# If POSTGRES_HOST_PORT changes, change this host URL's port as well.
# Compose replaces this URL with its internal postgres:5432 address.
DATABASE_URL=postgresql+psycopg://workspace:local-postgres-password@localhost:5432/ukladen

# Redis
# Required for host backend/workers. Compose replaces this with redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0

# Celery
# Uses REDIS_URL for the broker; there is no separate CELERY_BROKER_URL/result backend.
# Run one Beat and a separate materials-queue worker. See local-development.md.

# Authentication
# Local HTTP only. Home/production use Secure __Host- cookies and exact HTTPS origins.
AUTH_SESSION_COOKIE_NAME=ukladen_session
AUTH_CSRF_COOKIE_NAME=ukladen_csrf
AUTH_OAUTH_COOKIE_NAME=ukladen_oauth
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# JSON array; an empty array denies browser mutations. This is CSRF validation, not CORS.
AUTH_ALLOWED_ORIGINS='["http://localhost:8080","http://localhost:3000","http://localhost:8000"]'
# Optional policy overrides; values below are application defaults (seconds/characters).
# AUTH_SESSION_TTL_SECONDS=2592000
# AUTH_PASSWORD_MIN_LENGTH=12
# AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400
# AUTH_PASSWORD_RESET_TTL_SECONDS=3600
# Positive thresholds and windows; key scopes are in environment.md.
# AUTH_LOGIN_RATE_LIMIT=10
# AUTH_LOGIN_RATE_WINDOW_SECONDS=60
# AUTH_REGISTER_RATE_LIMIT=5
# AUTH_REGISTER_RATE_WINDOW_SECONDS=60
# AUTH_PASSWORD_CHANGE_RATE_LIMIT=5
# AUTH_PASSWORD_CHANGE_RATE_WINDOW_SECONDS=60
# AUTH_EMAIL_VERIFICATION_CONFIRM_RATE_LIMIT=5
# AUTH_EMAIL_VERIFICATION_CONFIRM_RATE_WINDOW_SECONDS=60
# AUTH_EMAIL_VERIFICATION_REQUEST_RATE_LIMIT=5
# AUTH_EMAIL_VERIFICATION_REQUEST_RATE_WINDOW_SECONDS=60
# AUTH_PASSWORD_RESET_CONFIRM_RATE_LIMIT=5
# AUTH_PASSWORD_RESET_CONFIRM_RATE_WINDOW_SECONDS=60
# AUTH_PASSWORD_RESET_REQUEST_RATE_LIMIT=5
# AUTH_PASSWORD_RESET_REQUEST_RATE_WINDOW_SECONDS=60

# Google OAuth
# Optional. Create a Web application OAuth client in Google Cloud Console.
# Leave all five values commented to disable browser Google login; set them together to enable it.
# Register the exact callback under Authorized redirect URIs. Never use the tunnel token here.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
# FRONTEND_AUTH_SUCCESS_URL=http://localhost:8080/workspace
# FRONTEND_AUTH_ERROR_URL=http://localhost:8080/auth/error
AUTH_OAUTH_STATE_TTL_SECONDS=600
# AUTH_GOOGLE_START_RATE_LIMIT=10
# AUTH_GOOGLE_START_RATE_WINDOW_SECONDS=60
# AUTH_GOOGLE_CALLBACK_RATE_LIMIT=10
# AUTH_GOOGLE_CALLBACK_RATE_WINDOW_SECONDS=60
# AUTH_GOOGLE_LINK_RATE_LIMIT=5
# AUTH_GOOGLE_LINK_RATE_WINDOW_SECONDS=60

# Email / SMTP
# Application default: disabled. Fake captures at most 100 messages per worker process;
# it does not deliver mail, log tokens or make new accounts ready for business APIs.
AUTH_EMAIL_DELIVERY_MODE=fake
# Required for clickable browser links; omit for manual token-only messages.
# Must be /auth/verify-email on an allowed origin. Reset/Google links reuse that origin.
AUTH_EMAIL_VERIFICATION_URL=http://localhost:8080/auth/verify-email
# Real email: select smtp above and obtain these values from your mail provider.
# Host and verified bare sender address are mandatory in smtp mode.
# Credentials must be supplied together, or both omitted for a trusted local receiver.
# SMTP_HOST=smtp.example.com
# SMTP_FROM_EMAIL=noreply@your-verified-domain.example
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10
# Implicit TLS: security=tls, port=465. Plaintext none permits no authentication;
# use it only with a trusted local receiver. TLS certificates are verified.

# Storage
# Required, nonempty S3 credentials. These also seed SeaweedFS's local Admin UI.
# Compose replaces the endpoint with http://seaweedfs:8333; host tools use localhost.
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=workspace
S3_SECRET_KEY=local-storage-password
S3_BUCKET=materials

# University / Schedule
# Public IIS only; no student credentials. API, worker and Beat must agree.
SCHEDULE_SYNC_ENABLED=true
SCHEDULE_SYNC_INTERVAL_SECONDS=3600

# AI / LLM
# Offline backend only; apply reviewed migrations before opting in.
AI_ENABLED=false
# Keep retention on after an approved AI migration, even when chat is disabled.
AI_RETENTION_ENABLED=false
AI_LLM_PROVIDER=fake
AI_LLM_MODEL=fake-v1
# Optional API-only real model catalog: see docs/development/ai-connections.md.
# AI_CONNECTIONS_FILE=/absolute/private/path/catalog.json

# Logging / Monitoring
# DEBUG adds safe application detail; no SQL/SDK payload dumps. Default: INFO.
LOG_LEVEL=INFO

# Deployment / Security
# All base Compose ports bind to localhost. For public home hosting, use .env.home.example.
# Never point integration tests at these services; use disposable test resources.

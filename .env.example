# Local development only. Replace credentials before any shared deployment.
POSTGRES_DB=ukladen
POSTGRES_USER=workspace
POSTGRES_PASSWORD=local-postgres-password
# Host port for local PostgreSQL access; change if 5432 is already in use.
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+psycopg://workspace:local-postgres-password@localhost:5432/ukladen
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=workspace
S3_SECRET_KEY=local-storage-password
S3_BUCKET=materials

# Application diagnostics. DEBUG adds safe application detail, never SDK/SQL payload dumps.
LOG_LEVEL=INFO

# Local HTTP cookies. Production defaults use Secure __Host- cookies.
AUTH_SESSION_COOKIE_NAME=ukladen_session
AUTH_CSRF_COOKIE_NAME=ukladen_csrf
AUTH_OAUTH_COOKIE_NAME=ukladen_oauth
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS='["http://localhost:8080","http://localhost:3000","http://localhost:8000"]'

# Development fake only; no external email is sent. The application default is disabled.
AUTH_EMAIL_DELIVERY_MODE=fake

# Verification links use this page; reset links use the same origin with /auth/reset-password.
# Use your public HTTPS origin in deployment.
# The origin must also appear in AUTH_ALLOWED_ORIGINS. Unset for manual token-only emails.
AUTH_EMAIL_VERIFICATION_URL=http://localhost:8080/auth/verify-email

# Real email: set AUTH_EMAIL_DELIVERY_MODE=smtp and configure your SMTP service.
# STARTTLS normally uses port 587; implicit TLS uses SMTP_SECURITY=tls and port 465.
# API and worker must receive the same settings. Credentials stay outside Git.
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM_EMAIL=noreply@your-verified-domain.example
SMTP_TIMEOUT_SECONDS=10
# SMTP_SECURITY=none is only for a trusted local development receiver, without credentials.

# Browser-bound OAuth state expires after ten minutes.
AUTH_OAUTH_STATE_TTL_SECONDS=600

# Google browser login. Redirect destinations are fixed configuration, not request input.
# Leave all unset to disable Google. Configure all three together when needed.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
# FRONTEND_AUTH_SUCCESS_URL=http://localhost:8080/
# FRONTEND_AUTH_ERROR_URL=http://localhost:8080/auth/error

# Official schedule imports for saved academic groups (API, worker and Beat).
SCHEDULE_SYNC_ENABLED=true
SCHEDULE_SYNC_INTERVAL_SECONDS=3600
